# EmailJS Configuration — EXAMPLE FILE
# Copy this to .env and fill in your real credentials
# Get these values from https://dashboard.emailjs.com/

# Service ID — found in Email Services tab
VITE_EMAILJS_SERVICE_ID=YOUR_SERVICE_ID

# Template ID — found in Email Templates tab
VITE_EMAILJS_TEMPLATE_ID=YOUR_TEMPLATE_ID

# Public Key — found in Account > API Keys
VITE_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY
